# ---------- API ----------
NODE_ENV=development
PORT=8787
DATABASE_URL=
SESSION_SECRET=            # >= 32 random chars: openssl rand -hex 32
WEB_ORIGIN=http://localhost:3000
APP_NAME=Dibora
AI_PROVIDER_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Verify.et manual-payment verification (server-side only; never NEXT_PUBLIC_*)
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_API_KEY=
VERIFY_ET_WEBHOOK_SECRET=
# Private receipt storage (mount a persistent volume here in production)
RECEIPT_STORAGE_DIR=./data/receipts
# Public receiving accounts shown to students (JSON array), e.g. [{"method":"telebirr","accountName":"Dibora","accountNumber":"09XXXXXXXX"}]
PAYMENT_ACCOUNTS=
# Social login settings are read by the API. The Telegram bot token is server-only; never expose it via NEXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DiboraStudentBot
# Session cookie SameSite. Default in production is None (site and API on different domains, e.g. vercel.app + onrender.com).
# Set to Lax when the site and API share one domain (app.example.com + api.example.com).
COOKIE_SAMESITE=
# One-time bootstrap (remove after first login)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_CONTENT=false
# ---------- Web ----------
# Browser-reachable API origin (set per Preview/Production deployment; the web client appends /api).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_NAME=Dibora
# true = browser-only demo with sample data (no server, NOT secure). Leave false for real use.
NEXT_PUBLIC_DEMO_MODE=false
